# Production Environment Configuration
# Copy this file to .env.production and fill in your actual values

# Database Configuration
POSTGRES_DB=tg_bot_prod
POSTGRES_USER=tg_bot_user
POSTGRES_PASSWORD=your_secure_postgres_password

# Redis Configuration
REDIS_PASSWORD=your_secure_redis_password

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_WEBHOOK_URL=https://bot.yourdomain.com/webhook/
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/oauth/google/callback

# Security Keys (generate secure random keys)
ENCRYPTION_KEY=your_32_byte_encryption_key_here
SECRET_KEY=your_secret_key_for_sessions
SESSION_SECRET_KEY=your_session_secret_key
OAUTH_TOKEN_ENCRYPTION_KEY=your_oauth_token_encryption_key

# Domain Configuration
DOMAIN=yourdomain.com
API_DOMAIN=api.yourdomain.com
BOT_DOMAIN=bot.yourdomain.com
GRAFANA_DOMAIN=grafana.yourdomain.com

# SSL Configuration
SSL_CERT_PATH=/etc/ssl/certs/yourdomain.com.crt
SSL_KEY_PATH=/etc/ssl/private/yourdomain.com.key

# Monitoring Configuration
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password
GRAFANA_SECRET_KEY=your_grafana_secret_key
PROMETHEUS_RETENTION=30d

# Error Reporting
ERROR_REPORTING_DSN=your_sentry_dsn_here

# Email Configuration (for notifications)
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USERNAME=alerts@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=true

# Backup Configuration
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_ACCESS_KEY=your_s3_access_key
BACKUP_S3_SECRET_KEY=your_s3_secret_key
BACKUP_RETENTION_DAYS=30

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=100

# Worker Configuration
WORKER_CONCURRENCY=8
WORKER_MAX_TASKS_PER_CHILD=1000

# API Configuration
API_WORKERS=4
API_MAX_REQUESTS=1000
API_TIMEOUT=30

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=/var/log/tg_bot

# Performance Configuration
ENABLE_COMPRESSION=true
ENABLE_CACHING=true
CACHE_DEFAULT_TIMEOUT=300

# Security Configuration
ENABLE_RATE_LIMITING=true
ENABLE_SECURITY_HEADERS=true
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,bot.yourdomain.com

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5
HEALTH_CHECK_INTERVAL=30

# File Storage
FILE_STORAGE_BACKEND=local
FILE_STORAGE_PATH=/var/lib/tg_bot/files
MAX_FILE_SIZE=10485760

# External Service Timeouts
TELEGRAM_API_TIMEOUT=30
GOOGLE_API_TIMEOUT=30
DATABASE_QUERY_TIMEOUT=30

# Resource Limits
MAX_REQUEST_SIZE=10485760
MAX_RESPONSE_SIZE=52428800

# Development vs Production
ENABLE_DEBUG_TOOLBAR=false
ENABLE_API_DOCS=false
ENABLE_SWAGGER_UI=false
